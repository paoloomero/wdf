{
  "manifest_version": 3,
  "name": "WDF \u2014 Save as WDF",
  "version": "0.1.2",
  "description": "Save the page you are reading as a verifiable WDF document \u2014 fully client-side, zero network, zero data collected.",
  "homepage_url": "https://wdf.dev",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Save as WDF",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ]
}
