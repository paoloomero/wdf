{
  "name": "wdf-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "sync:schemas": "node scripts/sync-schemas.mjs && node packages/core/scripts/compile-schemas.mjs",
    "golden:update": "pnpm --filter @wdf-dev/core build && node scripts/update-golden.mjs",
    "demo": "pnpm build && node scripts/build-demo.mjs",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.0.0"
  },
  "license": "Apache-2.0"
}
